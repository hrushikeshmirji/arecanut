{
  "name": "arecanut-project",
  "version": "1.0.0",
  "private": true,
  "description": "ArecaGuard AI Engine - Hybrid Detection & Diagnosis Stack",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,green.bold\" \"npm run backend\" \"npm run frontend\"",
    "backend": "python -m uvicorn main:app --host 127.0.0.1 --port 8000 --app-dir backend --reload",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "healthcheck": "python scripts/maintenance/run_full_project_healthcheck.py",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
